{
	"extends": "@tsconfig/node24/tsconfig.json",
	"compilerOptions": {
		"customConditions": [
			"node"
		],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"noImplicitOverride": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"vitest*.config.ts"
	],
	"exclude": [
		"node_modules"
	]
}